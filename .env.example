# یک کپی از این فایل با نام .env بسازید و مقادیر را پر کنید.
# install.sh این کار را خودکار انجام می‌دهد و SECRET_KEY تصادفی می‌سازد.

# کلید امنیتی جنگو (حتماً یک مقدار تصادفی و طولانی بگذارید)
SECRET_KEY=change-me-to-a-long-random-string

# در سرور حتماً False باشد
DEBUG=False

# دامنه/آی‌پی‌هایی که سایت روی آن‌ها باز می‌شود (با کاما جدا کنید)
# install.sh آی‌پی سرور را خودکار اضافه می‌کند. اگر با IP باز نشد، همین‌جا بگذارید.
ALLOWED_HOSTS=127.0.0.1,localhost

# اگر پشت دامنه با https هستید، origin را اینجا بگذارید
# CSRF_TRUSTED_ORIGINS=https://example.com

# منطقهٔ زمانی
TIME_ZONE=Asia/Tehran

# سطح لاگ (DEBUG/INFO/WARNING)
LOG_LEVEL=INFO

# پورت را install.sh موقع نصب از شما می‌پرسد و این خط را پر می‌کند
GUNICORN_BIND=0.0.0.0:PORT
GUNICORN_WORKERS=3

# محدودیت استعلام عمومی: ۳۰ درخواست در ۶۰ ثانیه برای هر IP
LOOKUP_RATE_LIMIT=30
LOOKUP_RATE_WINDOW=60

# --- اختیاری: پنل پیش‌فرض از طریق متغیر محیطی ---
# اگر در پنل ادمین هیچ پنلی نسازید، از این مقادیر استفاده می‌شود.
# توصیه می‌شود پنل‌ها را از طریق /admin اضافه کنید.
# XUI_URL=http://1.2.3.4:54321/path
# XUI_USERNAME=admin
# XUI_PASSWORD=admin
# XUI_VERIFY_SSL=False
